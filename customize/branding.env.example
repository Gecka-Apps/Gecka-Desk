# Deployment config consumed by customize/apply.sh.
# Copy to customize/branding.env (gitignored) for local builds; in CI these
# come from GitHub repository variables of the same name.
#
# Not secret: the rendezvous server and its PUBLIC key ship in every client
# binary. Kept out of git only to avoid passive scraping of the server.
GECKA_RENDEZVOUS_SERVER=your.rendezvous.example
GECKA_RS_PUB_KEY=base64-server-public-key
